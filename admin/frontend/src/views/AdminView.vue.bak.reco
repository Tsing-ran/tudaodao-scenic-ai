<template>
  <div class="admin-layout">

    <!-- ── 顶部导航栏 ── -->
    <header class="top-nav">
      <div class="tn-left">
        <div class="tn-logo" aria-hidden="true">
          <span class="tn-dot" style="background:#FF6B6B"/>
          <span class="tn-dot" style="background:#4ECDC4"/>
          <span class="tn-dot" style="background:#FFE66D"/>
          <span class="tn-dot" style="background:#A8E6CF"/>
        </div>
        <span class="tn-brand">途叨叨</span>
        <span class="tn-sep">·</span>
        <span class="tn-scenic">景区管理后台</span>
      </div>
      <div class="tn-right">


        <span class="tn-clock">{{ tnTime }}</span>

      </div>
    </header>


    <!-- ── 左侧导航栏 ── -->
    <aside class="sidebar">
<nav class="sidebar-nav">
        <button
          v-for="item in navItems" :key="item.key"
          class="nav-item"
          :class="{ active: activeTab === item.key }"
          :aria-current="activeTab === item.key ? 'page' : undefined"
          @click="activeTab = item.key"
        >
          <component :is="item.icon" :size="15" :stroke-width="1.5" aria-hidden="true" />
          <span>{{ item.label }}</span>
        </button>
      </nav>

      <div class="sidebar-footer">
        <div class="scenic-name-input">
          <MapPin :size="12" :stroke-width="1.5" aria-hidden="true" />
          <input v-model="sceneStore.scenicName" class="name-input" placeholder="景区名称" aria-label="景区名称" />
        </div>
        <div class="account-row" v-if="authStore.user">
          <div class="account-info">
            <UserCircle :size="14" :stroke-width="1.5" />
            <span>{{ authStore.user.username }}</span>
          </div>
          <button class="logout-btn" @click="handleLogout" title="退出登录" aria-label="退出登录">
            <LogOut :size="13" :stroke-width="1.5" aria-hidden="true" />
          </button>
        </div>
        <div class="sidebar-theme-row">
          <button class="sidebar-theme-btn" @click="toggleTheme">
            <Sun v-if="sidebarDark" :size="13" :stroke-width="1.5" />
            <Moon v-else :size="13" :stroke-width="1.5" />
            <span>{{ sidebarDark ? '浅色模式' : '深色模式' }}</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- ── 主内容区 ── -->
    <main class="admin-main">

      <!-- ═══ 形象管理 ═══ -->
      <div v-show="activeTab === 'avatar'" class="tab-content">
        <div class="page-header">
          <h2>数字人形象管理</h2>
          <span class="page-sub">为「{{ sceneStore.scenicName || '当前景区' }}」挑选形象 · 换装 · 音色 · 背景，实时预览后设为默认</span>
        </div>

        <div class="avatar-layout">
          <!-- 左列：形象库 + 换装 + 音色 + 背景 + AI 生成 -->
          <div class="avatar-col-config">
            <!-- 形象库 -->
            <div class="card">
              <div class="card-title"><UserCircle :size="14" :stroke-width="1.5" />形象库 · 身份</div>
              <div class="av-filters">
                <el-radio-group v-model="avStyle" size="small">
                  <el-radio-button v-for="s in AV_STYLES" :key="s" :value="s">{{ s }}</el-radio-button>
                </el-radio-group>
                <el-radio-group v-model="avGender" size="small">
                  <el-radio-button value="all">全部</el-radio-button>
                  <el-radio-button value="female">女</el-radio-button>
                  <el-radio-button value="male">男</el-radio-button>
                </el-radio-group>
              </div>
              <div class="av-grid">
                <button v-for="a in shownAvatars" :key="a.id"
                  :class="['av-card', { sel: a.id === selAvatar, soon: a.coming_soon }]"
                  :disabled="a.coming_soon" @click="pickAvatar(a)">
                  <img :src="a.preview" :alt="a.name" loading="lazy" />
                  <span class="av-name">{{ a.name }}</span>
                  <span v-if="a.coming_soon" class="av-badge soon">烘录中</span>
                  <CheckCircle v-else-if="a.id === selAvatar" class="av-check" :size="16" :stroke-width="2" />
                </button>
                <p v-if="!shownAvatars.length" class="av-empty">该分类暂无形象</p>
              </div>
            </div>

            <!-- 换装衣橱（聚焦甜美脸时出现） -->
            <div v-if="outfits.length" class="card">
              <div class="card-title"><Shirt :size="14" :stroke-width="1.5" />换装衣橱 · 同一张脸多套服装</div>
              <div class="av-wardrobe">
                <button v-for="o in outfits" :key="o.id"
                  :class="['wd-card', { sel: o.id === selAvatar }]" @click="pickAvatar(o)">
                  <img :src="o.preview" :alt="o.outfit || o.name" loading="lazy" />
                  <span>{{ o.outfit || o.name }}</span>
                </button>
              </div>
            </div>

            <!-- 音色 -->
            <div class="card">
              <div class="card-title"><Volume2 :size="14" :stroke-width="1.5" />音色</div>
              <div class="av-voices">
                <button v-for="v in voices" :key="v.id"
                  :class="['vc-card', { sel: v.id === selVoice }]" @click="selVoice = v.id">
                  <span class="vc-name">{{ v.name }}</span>
                  <span class="vc-tone">{{ v.tone }}</span>
                </button>
              </div>
            </div>

            <!-- 场景背景 -->
            <div class="card">
              <div class="card-title"><Eye :size="14" :stroke-width="1.5" />场景背景</div>
              <div class="av-bgs">
                <button v-for="b in backgrounds" :key="b.id"
                  :class="['bg-card', { sel: b.id === selBg }]" @click="selBg = b.id">
                  <img v-if="b.preview" :src="b.preview" :alt="b.name" loading="lazy" />
                  <div v-else class="bg-none">极简灰底</div>
                  <span>{{ b.name }}</span>
                </button>
              </div>
            </div>

            <!-- AI 生成专属向导 -->
            <div class="card">
              <div class="card-title"><Wand2 :size="14" :stroke-width="1.5" />生成专属向导（通义万相）</div>
              <el-input v-model="customPrompt" type="textarea" :rows="3"
                placeholder="描述想要的形象（如：身着唐装的儒雅男导游）。生成后自动烘成可驱动数字人并加入形象库" />
              <button class="primary-btn full-btn mt12" @click="handleGenerate" :disabled="sceneStore.isGeneratingAvatar">
                <Sparkles v-if="!sceneStore.isGeneratingAvatar" :size="14" :stroke-width="1.5" />
                <Loader2 v-else :size="14" :stroke-width="1.5" class="spin" />
                {{ sceneStore.isGeneratingAvatar ? '生成中…' : '生成并加入形象库' }}
              </button>
              <div v-if="sceneStore.isGeneratingAvatar" class="progress-wrap">
                <div class="progress-bar"><div class="progress-fill" :style="{ width: genProgress + '%' }" /></div>
                <span>万相AI正在生成专属形象…</span>
              </div>
            </div>
          </div>

          <!-- 右列：实时预览（9:16 大屏流，与游客 16:9 隔离） -->
          <div class="avatar-col-preview">
            <div class="card avatar-preview-card">
              <div class="card-title"><Eye :size="14" :stroke-width="1.5" />实时预览 · 9:16 大屏流（不打断游客）</div>
              <div class="avatar-preview-box">
                <video ref="previewVideoEl" class="preview-video" muted autoplay playsinline />
                <div v-if="applying" class="preview-applying"><Loader2 :size="26" :stroke-width="1.5" class="spin" /> 换形象中…</div>
              </div>
              <div class="preview-meta">
                <span>形象：{{ selAvatarName || '—' }}</span>
                <span>音色：{{ selVoiceName || '—' }}</span>
              </div>
              <button class="primary-btn full-btn mt12" :disabled="saving || !selAvatar" @click="saveDefault">
                <Save :size="14" :stroke-width="1.5" /> {{ saving ? '保存中…' : '设为本景区默认' }}
              </button>
              <button class="ghost-btn full-btn mt8" @click="reloadPreview">
                <RefreshCw :size="13" :stroke-width="1.5" /> 重连预览
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══ 知识库管理 ═══ -->
      <div v-show="activeTab === 'knowledge'" class="tab-content">
        <div class="page-header">
          <h2>知识库管理</h2>
          <span class="page-sub">管理景区讲解词、文史资料、常见问答等知识内容</span>
        </div>

        <!-- 子 Tab 导航 -->
        <div class="kb-nav mb24">
          <button :class="['kb-nav-btn', { active: kbTab === 'upload' }]" @click="kbTab = 'upload'">
            <UploadCloud :size="13" :stroke-width="1.5" />文件上传
          </button>
          <button :class="['kb-nav-btn', { active: kbTab === 'faq' }]" @click="kbTab = 'faq'">
            <HelpCircle :size="13" :stroke-width="1.5" />FAQ 问答
          </button>
          <button :class="['kb-nav-btn', { active: kbTab === 'text' }]" @click="kbTab = 'text'">
            <PenLine :size="13" :stroke-width="1.5" />文本段落
          </button>
          <button :class="['kb-nav-btn', { active: kbTab === 'config' }]" @click="kbTab = 'config'">
            <Settings2 :size="13" :stroke-width="1.5" />检索设置
          </button>
        </div>

        <!-- ── 文件上传 Tab ── -->
        <template v-if="kbTab === 'upload'">
          <div class="card mb16">
            <div class="card-title"><Upload :size="14" :stroke-width="1.5" />上传文档</div>
            <el-upload class="uploader" drag multiple :before-upload="beforeUpload"
              :http-request="handleKnowledgeUpload" :show-file-list="false"
              accept=".txt,.pdf,.docx,.md">
              <div class="upload-zone">
                <UploadCloud :size="32" :stroke-width="1" class="upload-ico" />
                <p class="upload-main">拖拽文件至此，或<em>点击上传</em></p>
                <p class="upload-hint">支持 .txt / .pdf / .docx / .md，单文件 ≤ 20MB</p>
              </div>
            </el-upload>
          </div>

          <div class="card">
            <div v-if="docDeletePending" class="undo-toast">
              已删除「{{ docDeletePending.name }}」
              <button class="link-btn" style="color:var(--c-gold-3);margin-left:auto" @click="undoDeleteDoc">撤销</button>
            </div>
            <div class="card-title">
              <FileText :size="14" :stroke-width="1.5" />文档列表
              <div class="search-wrap ml-auto">
                <Search :size="13" :stroke-width="1.5" class="search-ico" aria-hidden="true" />
                <input v-model="kbSearch" class="search-input" placeholder="搜索文档…" aria-label="搜索文档" />
              </div>
            </div>
            <el-table :data="filteredDocs" size="small">
              <el-table-column label="文档名称" min-width="200">
                <template #default="{ row }">
                  <div class="doc-cell">
                    <span class="doc-type" :class="row.type">{{ row.type.toUpperCase() }}</span>
                    {{ row.name }}
                  </div>
                </template>
              </el-table-column>
              <el-table-column prop="chunks" label="片段数" width="72" />
              <el-table-column prop="uploadTime" label="上传时间" width="138" />
              <el-table-column prop="size" label="大小" width="64" />
              <el-table-column label="状态" width="82">
                <template #default="{ row }">
                  <span class="status-pill" :class="[row.status === '已索引' ? 'green' : row.status === '不支持' ? 'red' : 'amber', { pulsing: row.status === '索引中' }]">{{ row.status }}</span>
                </template>
              </el-table-column>
              <el-table-column label="操作" width="130">
                <template #default="{ row }">
                  <div class="ops-cell">
                    <button class="link-btn rebuild" title="重新提取文档内容并分块" @click="rebuildDoc(row)">重建</button>
                    <span class="ops-sep" />
                    <button class="link-btn reindex" title="重新建立向量索引" @click="reindexDoc(row)">索引</button>
                    <span class="ops-sep" />
                    <button class="link-btn danger" @click="deleteDoc(row)">删除</button>
                  </div>
                </template>
              </el-table-column>
            </el-table>
            <div class="kb-summary">
              共 {{ knowledgeDocs.length }} 份 · 已索引 {{ knowledgeDocs.filter(d=>d.status==='已索引').length }} 份 · {{ totalSize }}
            </div>
          </div>

        </template>

        <!-- ── 检索设置 Tab ── -->
        <template v-else-if="kbTab === 'config'">
          <div class="card">
            <div class="card-title"><Settings2 :size="14" :stroke-width="1.5" />检索配置</div>
            <div class="form-grid">
              <div class="form-row">
                <label>检索策略</label>
                <el-select v-model="kbConfig.strategy" size="small" style="width:180px">
                  <el-option label="语义检索（推荐）" value="semantic" />
                  <el-option label="关键词检索" value="keyword" />
                  <el-option label="混合检索" value="hybrid" />
                </el-select>
              </div>
              <p class="config-hint">语义检索适合自然语言问答（推荐），关键词检索适合精确搜索，混合检索兼顾两者</p>
              <div class="form-row">
                <label>最大召回数</label>
                <el-input-number v-model="kbConfig.topK" :min="1" :max="10" size="small" />
              </div>
              <div class="form-row">
                <label>相似度阈值</label>
                <el-slider v-model="kbConfig.threshold" :min="0.1" :max="1" :step="0.05" style="width:160px" />
                <span class="threshold-val">{{ kbConfig.threshold.toFixed(2) }}</span>
              </div>
              <p class="config-hint">越高匹配越严格，建议保持在 0.65–0.80；过低会召回无关内容，过高会漏掉相关答案</p>
            </div>
            <button class="primary-btn mt12" @click="saveKbConfig">保存配置</button>
          </div>
        </template>

        <!-- ── FAQ 问答 Tab ── -->
        <template v-else-if="kbTab === 'faq'">
          <!-- 工具栏 -->
          <div class="card mb16">
            <div class="kb-toolbar">
              <div class="cat-tabs">
                <button v-for="c in faqCats" :key="c"
                  :class="['cat-btn', { active: faqCatFilter === c }]"
                  @click="faqCatFilter = c">{{ c }}</button>
              </div>
              <div class="kb-toolbar-right">
                <div class="search-wrap">
                  <Search :size="13" :stroke-width="1.5" class="search-ico" aria-hidden="true" />
                  <input v-model="faqSearchQ" class="search-input" placeholder="搜索问答…" aria-label="搜索问答" />
                </div>
                <button class="primary-btn" @click="startAddFaq">
                  <Plus :size="13" :stroke-width="2" />新增问答
                </button>
              </div>
            </div>
          </div>

          <!-- 新增表单 -->
          <div v-if="faqAdding" class="card mb16 edit-form-card">
            <div class="card-title"><Plus :size="14" :stroke-width="1.5" />新增问答</div>
            <div class="edit-form">
              <div class="edit-row">
                <label>问题</label>
                <input v-model="faqAddForm.q" class="edit-input" placeholder="输入游客常见问题…" />
              </div>
              <div class="edit-row edit-row-grow">
                <label>答案</label>
                <el-input v-model="faqAddForm.a" type="textarea" :rows="3" placeholder="输入详细答案…" />
              </div>
              <div class="edit-row">
                <label>分类</label>
                <el-select v-model="faqAddForm.cat" size="small" style="width:150px">
                  <el-option v-for="c in faqCats.slice(1)" :key="c" :label="c" :value="c" />
                </el-select>
              </div>
            </div>
            <div class="edit-actions">
              <button class="ghost-btn" @click="faqAdding = false"><X :size="13" :stroke-width="1.5" />取消</button>
              <button class="primary-btn" @click="saveAddFaq"><Check :size="13" :stroke-width="2" />保存</button>
            </div>
          </div>

          <!-- FAQ 列表 -->
          <div class="card">
            <div v-if="filteredFaq.length === 0" class="empty-state">
              <HelpCircle :size="28" :stroke-width="1" />
              <p>暂无问答，点击「新增问答」开始添加</p>
            </div>
            <div v-else class="faq-list">
              <div v-for="(item, idx) in filteredFaq" :key="item.id"
                :class="['faq-item', { editing: faqEditId === item.id, last: idx === filteredFaq.length-1 }]">

                <!-- 查看态 -->
                <template v-if="faqEditId !== item.id">
                  <div class="faq-view">
                    <div class="faq-q"><HelpCircle :size="12" class="faq-ico" />{{ item.q }}</div>
                    <div class="faq-a">{{ item.a }}</div>
                    <div class="faq-foot">
                      <span class="cat-badge">{{ item.cat }}</span>
                      <span class="item-date">{{ item.updated }}</span>
                      <div class="item-ops">
                        <button class="link-btn" @click="startEditFaq(item)">编辑</button>
                        <button class="link-btn danger" @click="deleteFaqItem(item)">删除</button>
                      </div>
                    </div>
                  </div>
                </template>

                <!-- 编辑态 -->
                <template v-else>
                  <div class="edit-form">
                    <div class="edit-row">
                      <label>问题</label>
                      <input v-model="faqEditForm.q" class="edit-input" />
                    </div>
                    <div class="edit-row edit-row-grow">
                      <label>答案</label>
                      <el-input v-model="faqEditForm.a" type="textarea" :rows="3" />
                    </div>
                    <div class="edit-row">
                      <label>分类</label>
                      <el-select v-model="faqEditForm.cat" size="small" style="width:150px">
                        <el-option v-for="c in faqCats.slice(1)" :key="c" :label="c" :value="c" />
                      </el-select>
                    </div>
                  </div>
                  <div class="edit-actions">
                    <button class="ghost-btn" @click="faqEditId = null"><X :size="13" :stroke-width="1.5" />取消</button>
                    <button class="primary-btn" @click="saveEditFaq(item)"><Check :size="13" :stroke-width="2" />保存</button>
                  </div>
                </template>
              </div>
            </div>
            <div class="kb-summary">共 {{ faqItems.length }} 条问答</div>
          </div>
        </template>

        <!-- ── 文本段落 Tab ── -->
        <template v-else-if="kbTab === 'text'">
          <!-- 工具栏 -->
          <div class="card mb16">
            <div class="kb-toolbar">
              <div class="cat-tabs">
                <button v-for="c in ['全部', ...textCats]" :key="c"
                  :class="['cat-btn', { active: textCatFilter === c }]"
                  @click="textCatFilter = c">{{ c }}</button>
              </div>
              <button class="primary-btn" @click="startAddText">
                <Plus :size="13" :stroke-width="2" />新增段落
              </button>
            </div>
          </div>

          <!-- 新增表单 -->
          <div v-if="textAdding" class="card mb16 edit-form-card">
            <div class="card-title"><Plus :size="14" :stroke-width="1.5" />新增文本段落</div>
            <div class="edit-form">
              <div class="edit-row-double">
                <div class="edit-row" style="flex:1">
                  <label>标题</label>
                  <input v-model="textAddForm.title" class="edit-input" placeholder="段落标题…" />
                </div>
                <div class="edit-row">
                  <label>分类</label>
                  <el-select v-model="textAddForm.cat" size="small" style="width:150px">
                    <el-option v-for="c in textCats" :key="c" :label="c" :value="c" />
                  </el-select>
                </div>
              </div>
              <div class="edit-row edit-row-grow">
                <label>内容</label>
                <div style="flex:1">
                  <el-input v-model="textAddForm.content" type="textarea" :rows="6" placeholder="输入知识内容…" />
                  <div class="char-count">{{ textAddForm.content.length }} 字</div>
                </div>
              </div>
            </div>
            <div class="edit-actions">
              <button class="ghost-btn" @click="textAdding = false"><X :size="13" :stroke-width="1.5" />取消</button>
              <button class="primary-btn" @click="saveAddText"><Check :size="13" :stroke-width="2" />保存</button>
            </div>
          </div>

          <!-- 文本列表 -->
          <div v-if="filteredText.length === 0" class="card empty-state">
            <PenLine :size="28" :stroke-width="1" />
            <p>暂无文本段落，点击「新增段落」开始添加</p>
          </div>
          <div v-else class="text-grid">
            <div v-for="item in filteredText" :key="item.id" class="card text-card">
              <!-- 查看态 -->
              <template v-if="textEditId !== item.id">
                <div class="text-view-header">
                  <span class="text-title">{{ item.title }}</span>
                  <span class="cat-badge">{{ item.cat }}</span>
                </div>
                <p class="text-preview">{{ item.content }}</p>
                <div class="faq-foot">
                  <span class="item-date">{{ item.updated }}</span>
                  <span class="char-hint">{{ item.content.length }} 字</span>
                  <div class="item-ops">
                    <button class="link-btn" @click="startEditText(item)">编辑</button>
                    <button class="link-btn danger" @click="deleteTextItem(item)">删除</button>
                  </div>
                </div>
              </template>

              <!-- 编辑态 -->
              <template v-else>
                <div class="edit-form">
                  <div class="edit-row-double">
                    <div class="edit-row" style="flex:1">
                      <label>标题</label>
                      <input v-model="textEditForm.title" class="edit-input" />
                    </div>
                    <div class="edit-row">
                      <label>分类</label>
                      <el-select v-model="textEditForm.cat" size="small" style="width:150px">
                        <el-option v-for="c in textCats" :key="c" :label="c" :value="c" />
                      </el-select>
                    </div>
                  </div>
                  <div class="edit-row edit-row-grow">
                    <label>内容</label>
                    <div style="flex:1">
                      <el-input v-model="textEditForm.content" type="textarea" :rows="6" />
                      <div class="char-count">{{ textEditForm.content.length }} 字</div>
                    </div>
                  </div>
                </div>
                <div class="edit-actions">
                  <button class="ghost-btn" @click="textEditId = null"><X :size="13" :stroke-width="1.5" />取消</button>
                  <button class="primary-btn" @click="saveEditText(item)"><Check :size="13" :stroke-width="2" />保存</button>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>

      <!-- ═══ 数据大屏 ═══ -->
      <Teleport to="body">
      <div v-show="activeTab === 'dashboard'" class="tab-dashboard-screen">

        <!-- 顶部标题栏 -->
        <header class="dsh-hd">
          <div class="dsh-hd-l">
            <span class="dsh-scenic">{{ sceneStore.scenicName || '景区智能服务' }}</span>
            <div class="dsh-ranges">
              <button v-for="r in ranges" :key="r.val"
                :class="['dsh-rb', { active: dashRange === r.val }]"
                @click="dashRange=r.val; refreshDashboard()">{{ r.label }}</button>
            </div>
          </div>
          <div class="dsh-hd-c">
            <span class="dsh-deco-line"></span>
            景区智能服务数据大屏
            <span class="dsh-deco-line dsh-deco-r"></span>
          </div>
          <div class="dsh-hd-r">
            <span class="dsh-hdate">{{ dashDate }}</span>
            <span class="dsh-htime">{{ dashClock }}</span>
            <button class="dsh-hbtn" @click="refreshDashboard" :disabled="dashLoading" title="刷新">
              <RefreshCw :size="12" :class="{ spin: dashLoading }" />
            </button>
            <button class="dsh-hbtn dsh-exit" @click="activeTab = 'avatar'" title="退出大屏">
              <X :size="12" />
            </button>
          </div>
        </header>

        <!-- 错误提示 -->
        <div v-if="dashError" class="dsh-error-bar">
          <AlertCircle :size="13" />&nbsp;数据加载失败，请检查网络连接
          <button @click="dashError=false; loadDashboard()">重试</button>
        </div>

        <!-- 主体布局 -->
        <div class="dsh-body" :key="chartAnimKey">

          <!-- 左列 -->
          <div class="dsh-col">
            <!-- KPI -->
            <div class="dsh-panel">
              <div class="dsh-phd">核心指标</div>
              <div class="dsh-kpi-grid">
                <div class="dsh-kpi" v-for="k in kpiList" :key="k.label">
                  <div class="dsh-kpi-ico" :style="{ color: k.color }">
                    <component :is="k.icon" :size="18" :stroke-width="1.5" />
                  </div>
                  <div class="dsh-kpi-body">
                    <div class="dsh-kpi-val" :style="{ color: k.color }">{{ k.value }}</div>
                    <div class="dsh-kpi-lbl">{{ k.label }}</div>
                  </div>
                </div>
              </div>
            </div>
            <!-- 功能使用率 -->
            <div class="dsh-panel dsh-pf">
              <div class="dsh-phd">功能使用率
                <span class="dsh-pmeta">活跃会话 {{ featureData.active_sessions ?? '--' }}</span>
              </div>
              <div ref="ecFeatures" class="dsh-ec dsh-ec-sm"></div>
            </div>
            <!-- 客群画像 -->
            <div class="dsh-panel dsh-pf">
              <div class="dsh-phd">客群画像</div>
              <div ref="ecProfile" class="dsh-ec dsh-ec-sm"></div>
            </div>
          </div>

          <!-- 中列 -->
          <div class="dsh-col dsh-col-c">
            <!-- 趋势主图 -->
            <div class="dsh-panel dsh-pm">
              <div class="dsh-phd">近7日交互趋势</div>
              <div ref="ecLine" class="dsh-ec dsh-ec-main"></div>
            </div>
            <!-- 情感 + 满意度 -->
            <div class="dsh-r2">
              <div class="dsh-panel dsh-pf">
                <div class="dsh-phd">情感分布</div>
                <div ref="ecDonut" class="dsh-ec dsh-ec-md"></div>
              </div>
              <div class="dsh-panel dsh-pf">
                <div class="dsh-phd">游客满意度
                  <span class="dsh-sat-n">{{ avgSatisfaction || '--' }}<small v-if="avgSatisfaction"> /5</small></span>
                </div>
                <div ref="ecSat" class="dsh-ec dsh-ec-md"></div>
              </div>
            </div>
          </div>

          <!-- 右列 -->
          <div class="dsh-col">
            <div class="dsh-panel dsh-pf">
              <div class="dsh-phd">热门话题 Top 5</div>
              <div ref="ecTopics" class="dsh-ec dsh-ec-lg"></div>
            </div>
            <div class="dsh-panel dsh-pf">
              <div class="dsh-phd">景点关注度</div>
              <div ref="ecSpots" class="dsh-ec dsh-ec-lg"></div>
            </div>
          </div>

        </div>
      </div>
      </Teleport>
      <!-- ═══ 感受度报告 ═══ -->
      <div v-show="activeTab === 'report'" class="tab-content">
        <div class="page-header">
          <h2>感受度报告</h2>
          <span class="page-sub">游客情感分析与服务优化建议</span>
          <div class="header-actions">
            <button class="ghost-btn sm" @click="refreshReport" :disabled="reportLoading">
              <RefreshCw :size="12" :stroke-width="1.5" :class="{ spin: reportLoading }" />刷新
            </button>
          </div>
        </div>

        <!-- loading 遮罩 -->
        <div v-if="reportLoading" class="report-loading">
          <Loader2 :size="22" :stroke-width="1.5" class="spin" />
          <span>数据加载中…</span>
        </div>
        <div v-else-if="reportError" class="dash-error-banner">
          <AlertCircle :size="14" :stroke-width="1.5" />
          数据加载失败，请检查网络连接或后端服务
          <button class="ghost-btn sm" style="margin-left:auto" @click="reportError=false; loadReport()">重试</button>
        </div>
        <template v-else>

        <!-- 摘要 -->
        <div class="summary-strip">
          <div v-for="s in reportSummary" :key="s.label" class="summary-metric">
            <span class="metric-num" :style="{ color: s.color }">{{ s.val }}</span>
            <span class="metric-label">{{ s.label }}</span>
          </div>
        </div>

        <div class="two-col mt16">
          <!-- 情感分布 -->
          <div class="card">
            <div class="card-title"><Activity :size="14" :stroke-width="1.5" />情感分布</div>
            <div class="emotion-dist">
              <div v-for="e in emotionDist" :key="e.label" class="emo-item">
                <div class="emo-bar-track">
                  <div class="emo-bar-fill" :style="{ width: e.pct+'%', background: e.color }" />
                </div>
                <div class="emo-meta">
                  <span class="emo-label">{{ e.label }}</span>
                  <span class="emo-pct" :style="{ color: e.color }">{{ e.pct }}%</span>
                </div>
              </div>
            </div>

            <div class="section-divider">近7日情感趋势</div>
            <div class="trend-stacks">
              <div v-for="(d,i) in emotionTrendData" :key="i" class="stack-col">
                <div class="stack-bar">
                  <div class="seg positive" :style="{ flex: d.positive }" />
                  <div class="seg neutral"  :style="{ flex: d.neutral  }" />
                  <div class="seg negative" :style="{ flex: d.negative }" />
                </div>
                <span>{{ d.day }}</span>
              </div>
            </div>
            <div class="stack-legend">
              <span class="leg pos">积极</span>
              <span class="leg neu">中性</span>
              <span class="leg neg">消极</span>
            </div>
          </div>

          <!-- 关注点 -->
          <div class="card">
            <div class="card-title"><Search :size="14" :stroke-width="1.5" />游客关注点</div>
            <div class="tag-cloud">
              <span v-for="c in concernTags" :key="c.tag" class="cloud-tag"
                :style="{ fontSize:(12+c.weight*7)+'px', color:c.color, opacity:0.5+c.weight*0.5 }">
                {{ c.tag }}
              </span>
            </div>
            <div class="section-divider">关注点排名</div>
            <div class="concern-rows">
              <div v-for="(c,i) in topConcerns" :key="i" class="concern-row">
                <span class="c-rank">{{ i+1 }}</span>
                <span class="c-name">{{ c.name }}</span>
                <div class="c-track"><div class="c-fill" :style="{ width: c.pct+'%' }" /></div>
                <span class="c-pct">{{ c.pct }}%</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 优化建议 -->
        <div class="card mt16">
          <div class="card-title"><Lightbulb :size="14" :stroke-width="1.5" />AI服务优化建议</div>
          <div class="suggestion-list">
            <div v-for="(s,i) in serviceSuggestions" :key="i" class="sug-item" :class="s.priority">
              <span class="sug-badge">{{ { high:'高优', mid:'中优', low:'低优' }[s.priority] }}</span>
              <div class="sug-body">
                <div class="sug-title">{{ s.title }}</div>
                <div class="sug-desc">{{ s.desc }}</div>
              </div>
              <span class="sug-impact">+{{ s.impact }}% 满意度</span>
            </div>
          </div>
        </div>

        <!-- 对话摘录 -->
        <div class="card mt16">
          <div class="card-title"><MessageSquare :size="14" :stroke-width="1.5" />典型对话摘录</div>
          <div v-if="dialogueSamples.length" class="dialogue-list">
            <div v-for="(d,i) in dialogueSamples" :key="i" class="dialogue-item">
              <div class="dlg-meta">
                <span class="dlg-time">{{ d.time }}</span>
                <span class="sentiment-tag" :class="d.sentiment">
                  {{ { positive:'积极', negative:'消极', neutral:'中性' }[d.sentiment] }}
                </span>
              </div>
              <div class="dlg-q">{{ d.question }}</div>
              <div class="dlg-a">{{ d.answer }}</div>
            </div>
          </div>
          <div v-else class="empty-state">
            <MessageSquare :size="24" :stroke-width="1" />
            <p>暂无对话记录</p>
          </div>
        </div>
        </template>
      </div>

    </main>

    <!-- ── AI 分析助手面板 ── -->
    <aside class="ai-panel" :class="{ collapsed: !aiPanelOpen }">
      <div class="ai-panel-header">
        <button class="ai-toggle-btn" @click="aiPanelOpen = !aiPanelOpen" :title="aiPanelOpen ? '收起助手' : '展开助手'">
          <ChevronRight :size="13" :stroke-width="2" :class="{ flipped: !aiPanelOpen }" />
        </button>
        <Sparkles :size="13" :stroke-width="1.5" class="ai-header-ico" aria-hidden="true" />
        <span class="ai-header-title">智能分析助手</span>
        <span class="ai-online-dot" aria-hidden="true" />
      </div>

      <div class="ai-messages" ref="aiChatEl">
        <div v-if="aiMessages.length === 0" class="ai-welcome">
          <div class="ai-bot-icon"><Bot :size="22" :stroke-width="1" aria-hidden="true" /></div>
          <p class="ai-welcome-title">景区数据分析助手</p>
          <p class="ai-welcome-sub">可询问运营数据解读、游客情感分析、知识库优化建议等</p>
          <div class="ai-quick-list">
            <button v-for="q in aiQuickQuestions" :key="q" class="ai-quick-chip" @click="sendQuickQuestion(q)">{{ q }}</button>
          </div>
        </div>

        <template v-else>
          <div v-for="msg in aiMessages" :key="msg.id" :class="['ai-msg-row', msg.role]">
            <div v-if="msg.role === 'assistant'" class="ai-msg-icon">
              <Bot :size="11" :stroke-width="1.5" />
            </div>
            <div :class="['ai-bubble', msg.role, { error: msg.error }]">
              <span v-if="msg.loading" class="ai-typing-dots"><i /><i /><i /></span>
              <span v-else>{{ msg.content }}</span>
            </div>
          </div>
        </template>
      </div>

      <div class="ai-input-wrap">
        <textarea
          v-model="aiInput"
          ref="aiTextareaEl"
          class="ai-input"
          placeholder="向AI助手提问…"
          aria-label="向AI助手提问"
          rows="1"
          :disabled="aiLoading"
          @keydown.enter.exact.prevent="sendAiMessage"
          @input="autoResizeTextarea"
        />
        <button
          class="ai-send"
          :class="{ active: aiInput.trim() && !aiLoading }"
          :disabled="!aiInput.trim() || aiLoading"
          aria-label="发送"
          @click="sendAiMessage"
        >
          <Send :size="13" :stroke-width="2" aria-hidden="true" />
        </button>
      </div>
    </aside>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, onUnmounted, nextTick, watch } from 'vue'
import * as echarts from 'echarts'
import { useSceneStore } from '@/stores/scene'
import { useAuthStore } from '@/stores/auth'
import { useRouter } from 'vue-router'
import { ElMessage, ElMessageBox } from 'element-plus'
import axios from 'axios'
import {
  Signal, Home,
  Landmark, MapPin, Wand2, Eye, Users, UserCircle, UserX,
  Upload, UploadCloud, FileText, Search, Settings2, RefreshCw,
  BarChart2, MessageSquare, Star, TrendingUp, TrendingDown,
  Activity, Lightbulb, Check, LogOut,
  CheckCircle, Sparkles, Loader2, AlertCircle,
  HelpCircle, PenLine, Plus, X,
  Bot, Send, Clock, ChevronRight,
  Shirt, Volume2, Save, Sun, Moon
} from 'lucide-vue-next'
import mpegts from 'mpegts.js'
import {
  getDigitalHumanPresets, getDigitalHumanConfig, saveDigitalHumanConfig,
  liveSetAvatar, PORTRAIT_FLV,
} from '@/api/index'

const sceneStore = useSceneStore()
const authStore  = useAuthStore()
const router     = useRouter()

const activeTab   = ref(localStorage.getItem('adminTab') || 'avatar')
const chartAnimKey = ref(0)
watch(activeTab, async (tab) => {
  localStorage.setItem('adminTab', tab)
  if (tab === 'dashboard') {
    chartAnimKey.value++          // key++ 销毁旧 DOM，先清 ECharts 实例
    Object.values(_ec).forEach(c => c?.dispose())
    _ec = {}
    if (!dashLoaded.value) {
      loadDashboard()
    } else {
      await nextTick()            // 等新 DOM 就绪后重绘
      _ecUpdate()
    }
  }
  if (tab === 'report') {
    if (!reportLoaded.value) loadReport()
  }
  if (tab === 'avatar') {
    await loadAvatarTab()
    await nextTick()
    startPreview()
  } else {
    destroyPreview()
  }
})

const navItems = [
  { key:'avatar',    label:'形象管理', icon: Wand2 },
  { key:'knowledge', label:'知识库',   icon: FileText },
  { key:'dashboard', label:'数据大屏', icon: BarChart2 },
  { key:'report',    label:'感受度报告', icon: Activity },
]

function handleLogout() { authStore.logout(router) }

// ── 形象管理（形象库 + 换装 + 音色 + 背景 + 实时预览 + 设默认）──────────────
const AV_STYLES = ['推荐', '现代', '古风', '民族']
const SWEET_BASE = 'female_sweet'
const SWEET_OUTFITS = ['outfit_qipao', 'outfit_hanfu', 'outfit_blazer', 'outfit_ethnic', 'outfit_vest', 'outfit_coat']

const avatars = ref([]); const voices = ref([]); const backgrounds = ref([])
const avStyle = ref('推荐'); const avGender = ref('all')
const selAvatar = ref(''); const selVoice = ref(''); const selBg = ref('')
const applying = ref(false); const saving = ref(false)
const previewVideoEl = ref(null); let flvPlayer = null

const identities = computed(() => avatars.value.filter(a => !SWEET_OUTFITS.includes(a.id)))
const shownAvatars = computed(() => identities.value.filter(a =>
  (avStyle.value === '推荐' ? a.recommended : a.style === avStyle.value) &&
  (avGender.value === 'all' || a.gender === avGender.value)))
const outfits = computed(() => {
  if (selAvatar.value !== SWEET_BASE && !SWEET_OUTFITS.includes(selAvatar.value)) return []
  const byId = new Map(avatars.value.map(a => [a.id, a]))
  return [SWEET_BASE, ...SWEET_OUTFITS].map(id => byId.get(id)).filter(Boolean)
})
const selAvatarName = computed(() => avatars.value.find(a => a.id === selAvatar.value)?.name || '')
const selVoiceName = computed(() => voices.value.find(v => v.id === selVoice.value)?.name || '')

async function loadAvatarTab() {
  try {
    const p = await getDigitalHumanPresets()
    avatars.value = (p.avatars || []).filter(a => !a.legacy)
    voices.value = p.voices || []
    backgrounds.value = p.backgrounds || []
    const cfg = await getDigitalHumanConfig(sceneStore.scenicId)
    selAvatar.value = cfg.avatar_id || SWEET_BASE
    selVoice.value = cfg.voice_id || 'voice_gentle_f'
    selBg.value = cfg.background_id || ''
  } catch { ElMessage.error('加载形象库失败') }
}

async function pickAvatar(a) {
  if (a.coming_soon) return
  selAvatar.value = a.id
  applying.value = true
  const r = await liveSetAvatar(a.id, sceneStore.scenicId, 'portrait')
  applying.value = false
  if (!r || !r.ok) ElMessage.warning('预览切换失败（大屏流可能未就绪，点「重连预览」重试）')
}

async function saveDefault() {
  if (!selAvatar.value) return
  saving.value = true
  try {
    const av = avatars.value.find(a => a.id === selAvatar.value)
    const vc = voices.value.find(v => v.id === selVoice.value)
    const bg = backgrounds.value.find(b => b.id === selBg.value)
    await saveDigitalHumanConfig({
      scenic_id: sceneStore.scenicId,
      avatar_id: selAvatar.value, avatar_name: av?.name || selAvatar.value,
      voice_id: selVoice.value, voice_name: vc?.name || '',
      background_id: selBg.value || '', background_name: bg?.name || '',
    })
    ElMessage.success(`已设为「${sceneStore.scenicName || sceneStore.scenicId}」默认形象`)
  } catch { ElMessage.error('保存失败') }
  finally { saving.value = false }
}

function startPreview() {
  if (!previewVideoEl.value || !mpegts.isSupported()) return
  destroyPreview()
  try {
    flvPlayer = mpegts.createPlayer(
      { type: 'flv', isLive: true, url: PORTRAIT_FLV },
      { liveBufferLatencyChasing: true, lazyLoad: false })
    flvPlayer.attachMediaElement(previewVideoEl.value)
    flvPlayer.load()
    flvPlayer.play().catch(() => {})
  } catch {}
}
function destroyPreview() { if (flvPlayer) { try { flvPlayer.destroy() } catch {} flvPlayer = null } }
function reloadPreview() { startPreview() }

// AI 生成专属向导（通义万相）→ 烘录入库（真入库 pipeline 开发中，当前先出预览图）
const customPrompt = ref('')
const genProgress  = ref(0)
let progressTimer = null
async function handleGenerate() {
  genProgress.value = 0
  progressTimer = setInterval(() => { genProgress.value = Math.min(genProgress.value + 3, 90) }, 500)
  try {
    await sceneStore.generateAvatar(null, customPrompt.value || null)
    genProgress.value = 100
    ElMessage.success('形象已生成（烘录入库链路开发中）')
  } catch { ElMessage.error('生成失败，请检查 DashScope 余额/Key') }
  finally { clearInterval(progressTimer) }
}

// ── 知识库管理 ─────────────────────────────────
const kbSearch = ref('')
const kbConfig = ref({ strategy:'semantic', topK:5, threshold:0.7 })

const knowledgeDocs = ref([])

const statusMap = { indexed:'已索引', indexing:'索引中', unsupported:'不支持', '已上传':'已上传' }
function fmtDoc(d) {
  const ext = (d.filename || '').split('.').pop().toLowerCase()
  const bytes = d.size_bytes || 0
  const size = bytes < 1024 ? `${bytes}B` : bytes < 1024**2 ? `${(bytes/1024).toFixed(1)}KB` : `${(bytes/1024**2).toFixed(1)}MB`
  return {
    id: d.id,
    name: d.filename || d.name,
    type: ext,
    chunks: d.chunks ?? '-',
    uploadTime: (d.created_at || d.uploadTime || '').slice(0, 16).replace('T', ' '),
    size,
    sizeBytes: bytes,
    status: statusMap[d.status] || d.status,
  }
}

async function loadKnowledgeDocs() {
  try {
    const params = sceneStore.scenicId ? { scenic_id: sceneStore.scenicId } : {}
    const res = await axios.get('/api/knowledge/docs', { params })
    if (res.data.code === 0) knowledgeDocs.value = (res.data.data?.docs || []).map(fmtDoc)
  } catch { /* 后端未启动时静默 */ }
}

const filteredDocs = computed(() =>
  kbSearch.value ? knowledgeDocs.value.filter(d => d.name.includes(kbSearch.value) || d.type.includes(kbSearch.value))
                 : knowledgeDocs.value
)

const totalSize = computed(() => {
  const bytes = knowledgeDocs.value.reduce((a, d) => a + (d.sizeBytes || 0), 0)
  if (bytes < 1024) return `${bytes}B`
  if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)}KB`
  return `${(bytes / 1024 ** 2).toFixed(1)}MB`
})

function beforeUpload(file) {
  if (file.size / 1024 / 1024 > 20) { ElMessage.error('文件不能超过 20MB'); return false }
  return true
}

async function handleKnowledgeUpload({ file }) {
  const formData = new FormData()
  formData.append('files', file)
  formData.append('scenic_id', sceneStore.scenicId || 'lingshan')
  try {
    const res = await axios.post('/api/knowledge/upload', formData)
    if (res.data.code === 0) {
      await loadKnowledgeDocs()
      const items = res.data.data?.items || []
      const unsupported = items.filter(i => i.status === 'unsupported')
      if (unsupported.length) ElMessage.warning(`${unsupported.map(i=>i.filename).join('、')} 无文本层，未入库`)
      else ElMessage.success(`上传成功，共 ${items.reduce((a,i)=>a+(i.chunks||0),0)} 个片段已索引`)
    }
  } catch (e) {
    ElMessage.error('上传失败：' + (e.response?.data?.detail || e.message))
  }
}

const docDeletePending = ref(null)
let _docDeleteTimer = null

async function deleteDoc(row) {
  await ElMessageBox.confirm(
    `「${row.name}」删除后无法恢复。`,
    '删除文档', { type:'warning', confirmButtonText:'删除', cancelButtonText:'取消' }
  )
  knowledgeDocs.value = knowledgeDocs.value.filter(d => d.id !== row.id)
  docDeletePending.value = row
  clearTimeout(_docDeleteTimer)
  _docDeleteTimer = setTimeout(async () => {
    if (!docDeletePending.value) return
    try { await axios.delete(`/api/knowledge/docs/${docDeletePending.value.id}`) }
    catch { await loadKnowledgeDocs(); ElMessage.error('删除失败，文档已恢复') }
    docDeletePending.value = null
  }, 5000)
}

function undoDeleteDoc() {
  clearTimeout(_docDeleteTimer)
  if (docDeletePending.value) {
    knowledgeDocs.value = [docDeletePending.value, ...knowledgeDocs.value]
    docDeletePending.value = null
    ElMessage.success('已撤销')
  }
}

function rebuildDoc(row) {
  row.status = '索引中'
  setTimeout(() => { row.status = '已索引' }, 2000)
  ElMessage.info('正在重新解析文档…')
}

function reindexDoc(row) {
  row.status = '索引中'
  setTimeout(() => { row.status = '已索引' }, 1500)
  ElMessage.info('正在重建检索索引…')
}

function saveKbConfig() { ElMessage.success('检索配置已保存') }

// ── 知识库子 Tab ──────────────────────────────
const kbTab = ref('upload')

// ── FAQ 问答 ──────────────────────────────────
const faqCats    = ['全部', '基础信息', '景点介绍', '票务信息', '交通停车', '餐饮服务', '历史文化']
const faqCatFilter = ref('全部')
const faqSearchQ   = ref('')

const faqItems = ref([])

async function loadFaq() {
  try {
    const params = sceneStore.scenicId ? { scenic_id: sceneStore.scenicId } : {}
    const res = await axios.get('/api/knowledge/faq', { params })
    if (res.data.code === 0) {
      faqItems.value = (res.data.data || []).map(f => ({
        id: f.id, q: f.question, a: f.answer, cat: f.category, updated: f.updated_at?.slice(0,10) || ''
      }))
    }
  } catch { /* 静默 */ }
}

const filteredFaq = computed(() => {
  let list = faqItems.value
  if (faqCatFilter.value !== '全部') list = list.filter(f => f.cat === faqCatFilter.value)
  if (faqSearchQ.value) {
    const q = faqSearchQ.value
    list = list.filter(f => f.q.includes(q) || f.a.includes(q))
  }
  return list
})

const faqAdding  = ref(false)
const faqAddForm = ref({ q:'', a:'', cat:'基础信息' })
const faqEditId  = ref(null)
const faqEditForm = ref({ q:'', a:'', cat:'基础信息' })

function startAddFaq() { faqAdding.value = true; faqAddForm.value = { q:'', a:'', cat:'基础信息' } }
async function saveAddFaq() {
  if (!faqAddForm.value.q.trim() || !faqAddForm.value.a.trim()) { ElMessage.error('问题和答案不能为空'); return }
  try {
    await axios.post('/api/knowledge/faq', {
      scenic_id: sceneStore.scenicId || 'lingshan',
      question: faqAddForm.value.q,
      answer: faqAddForm.value.a,
      category: faqAddForm.value.cat,
    })
    faqAdding.value = false
    await loadFaq()
    ElMessage.success('已添加')
  } catch (e) { ElMessage.error('添加失败：' + (e.response?.data?.detail || e.message)) }
}
function startEditFaq(item) {
  faqEditId.value = item.id
  faqEditForm.value = { q: item.q, a: item.a, cat: item.cat }
}
async function saveEditFaq(item) {
  if (!faqEditForm.value.q.trim() || !faqEditForm.value.a.trim()) { ElMessage.error('问题和答案不能为空'); return }
  try {
    await axios.put(`/api/knowledge/faq/${item.id}`, {
      scenic_id: sceneStore.scenicId || 'lingshan',
      question: faqEditForm.value.q,
      answer: faqEditForm.value.a,
      category: faqEditForm.value.cat,
    })
    faqEditId.value = null
    await loadFaq()
    ElMessage.success('已保存')
  } catch (e) { ElMessage.error('保存失败：' + (e.response?.data?.detail || e.message)) }
}
async function deleteFaqItem(item) {
  await ElMessageBox.confirm(`「${item.q}」删除后无法恢复。`, '删除问答', { type:'warning', confirmButtonText:'删除', cancelButtonText:'取消' })
  try {
    await axios.delete(`/api/knowledge/faq/${item.id}`)
    faqItems.value = faqItems.value.filter(f => f.id !== item.id)
    ElMessage.success('已删除')
  } catch (e) { ElMessage.error('删除失败：' + (e.response?.data?.detail || e.message)) }
}

// ── 文本段落 ──────────────────────────────────
const textCats     = ['景区概况', '景点讲解', '历史文化', '服务信息', '活动介绍']
const textCatFilter = ref('全部')

const textItems = ref([])

async function loadText() {
  try {
    const params = sceneStore.scenicId ? { scenic_id: sceneStore.scenicId } : {}
    const res = await axios.get('/api/knowledge/text', { params })
    if (res.data.code === 0) {
      textItems.value = (res.data.data || []).map(t => ({
        id: t.id, title: t.title, cat: t.category, content: t.content, updated: t.updated_at?.slice(0,10) || ''
      }))
    }
  } catch { /* 静默 */ }
}

const filteredText = computed(() => {
  if (textCatFilter.value === '全部') return textItems.value
  return textItems.value.filter(t => t.cat === textCatFilter.value)
})

const textAdding  = ref(false)
const textAddForm = ref({ title:'', cat:'景区概况', content:'' })
const textEditId  = ref(null)
const textEditForm = ref({ title:'', cat:'景区概况', content:'' })

function startAddText() { textAdding.value = true; textAddForm.value = { title:'', cat:'景区概况', content:'' } }
async function saveAddText() {
  if (!textAddForm.value.title.trim() || !textAddForm.value.content.trim()) { ElMessage.error('标题和内容不能为空'); return }
  try {
    await axios.post('/api/knowledge/text', {
      scenic_id: sceneStore.scenicId || 'lingshan',
      title: textAddForm.value.title,
      content: textAddForm.value.content,
      category: textAddForm.value.cat,
    })
    textAdding.value = false
    await loadText()
    ElMessage.success('已添加')
  } catch (e) { ElMessage.error('添加失败：' + (e.response?.data?.detail || e.message)) }
}
function startEditText(item) {
  textEditId.value = item.id
  textEditForm.value = { title: item.title, cat: item.cat, content: item.content }
}
async function saveEditText(item) {
  if (!textEditForm.value.title.trim() || !textEditForm.value.content.trim()) { ElMessage.error('标题和内容不能为空'); return }
  try {
    await axios.put(`/api/knowledge/text/${item.id}`, {
      scenic_id: sceneStore.scenicId || 'lingshan',
      title: textEditForm.value.title,
      content: textEditForm.value.content,
      category: textEditForm.value.cat,
    })
    textEditId.value = null
    await loadText()
    ElMessage.success('已保存')
  } catch (e) { ElMessage.error('保存失败：' + (e.response?.data?.detail || e.message)) }
}
async function deleteTextItem(item) {
  await ElMessageBox.confirm(`「${item.title}」删除后无法恢复。`, '删除段落', { type:'warning', confirmButtonText:'删除', cancelButtonText:'取消' })
  try {
    await axios.delete(`/api/knowledge/text/${item.id}`)
    textItems.value = textItems.value.filter(t => t.id !== item.id)
    ElMessage.success('已删除')
