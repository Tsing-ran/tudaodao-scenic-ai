  { val: 'zh', label: '中' },
  { val: 'en', label: 'EN' },
  { val: 'ja', label: '日' },
  { val: 'ko', label: '한' },
]
const tnTime     = ref('')
const tnGpsLabel = ref('一般')

let _tnTimer = null
function _updateTnTime() {
