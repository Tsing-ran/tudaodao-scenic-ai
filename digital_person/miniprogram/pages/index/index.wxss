/* ===== 灵境·导览 主交互页 ===== */
.app {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #0c0e14;
}

/* ── 数字人画面 ── */
.hero { position: absolute; inset: 0; z-index: 0; background: #0c0e14; }
.hero-video { width: 100%; height: 100%; }
.hero-fallback {
  position: absolute; inset: 0; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 24rpx;
  background: radial-gradient(120% 80% at 50% 28%, #1d2440, #0c0e14 72%);
}
.hf-orb {
  width: 168rpx; height: 168rpx; border-radius: 50%; display: flex;
  align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(91,120,255,.32), rgba(22,183,166,.28));
  border: 2rpx solid rgba(255,255,255,.18);
  box-shadow: 0 0 80rpx rgba(91,120,255,.4);
}
.hf-ic { width: 72rpx; height: 72rpx; }
.hf-txt { color: var(--on-dark-2); font-size: 26rpx; letter-spacing: 1rpx; }
/* 调试 HUD：固定屏幕中部、最高层级，真机必可见（定位 HLS 卡点；上线前删） */
.vdebug {
  position: fixed; left: 20rpx; right: 20rpx; top: 40%; z-index: 9999;
  padding: 20rpx 24rpx; border-radius: 16rpx;
  background: rgba(0,0,0,.85); border: 2rpx solid #6effa8;
  display: flex; flex-direction: column; gap: 10rpx;
}
.vdebug-title { color: #6effa8; font-size: 24rpx; font-weight: 700; }
.vdebug-body {
  color: #b6ffd0; font-size: 22rpx; line-height: 1.6;
  font-family: monospace; word-break: break-all;
}

.scrim {
  position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: linear-gradient(180deg, rgba(12,14,20,.62) 0%, rgba(12,14,20,0) 20% 52%, rgba(12,14,20,.82) 100%);
}

/* ── 导航栏 ── */
.nav { position: absolute; top: 0; left: 0; right: 0; z-index: 6; display: flex; align-items: center; padding-left: 28rpx; }
.brand { display: flex; align-items: center; gap: 16rpx; }
.brand-logo {
  width: 60rpx; height: 60rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center;
  background: var(--brand-grad); box-shadow: var(--sh-brand);
}
.brand-spark { width: 34rpx; height: 34rpx; }
.brand-text { display: flex; flex-direction: column; line-height: 1.16; }
.brand-name { color: #fff; font-size: 32rpx; font-weight: 700; letter-spacing: 2rpx; text-shadow: 0 2rpx 10rpx rgba(0,0,0,.35); }
.brand-sub { color: var(--on-dark-2); font-size: 20rpx; letter-spacing: 3rpx; }

/* ── 选择器 ── */
.selectors { position: absolute; left: 28rpx; right: 28rpx; z-index: 6; display: flex; gap: 14rpx; }
.sel-chip {
  display: flex; align-items: center; gap: 6rpx; padding: 12rpx 18rpx; border-radius: var(--r-pill);
  background: var(--glass-dark); backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,.16); color: #fff; font-size: 25rpx; font-weight: 600;
}
.sel-arrow { width: 22rpx; height: 22rpx; opacity: .8; }

/* ── 连接状态 ── */
.status {
  position: absolute; left: 28rpx; z-index: 6; display: flex; align-items: center; gap: 10rpx;
  padding: 8rpx 18rpx; border-radius: var(--r-pill); background: rgba(0,0,0,.36);
  backdrop-filter: blur(10rpx); color: #fff; font-size: 22rpx;
}
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--danger); transition: background .3s var(--ease); }
.dot.on { background: var(--ok); box-shadow: 0 0 0 6rpx rgba(31,194,138,.22); }

/* ── 行程游记 FAB ── */
.fab {
  position: absolute; right: 28rpx; bottom: 360rpx; z-index: 7;
  width: 92rpx; height: 92rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: var(--glass-dark); backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,.18); box-shadow: var(--sh-2);
}
.fab-ic { width: 44rpx; height: 44rpx; }

/* ── 字幕区 ── */
.caption { position: absolute; left: 28rpx; right: 28rpx; bottom: 300rpx; z-index: 4; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 14rpx; }
.tag {
  display: inline-flex; align-items: center; gap: 6rpx; font-size: 22rpx; font-weight: 600; color: #fff;
  padding: 7rpx 16rpx; border-radius: var(--r-pill); background: var(--glass-dark); backdrop-filter: blur(12rpx);
}
.tag-ic { width: 22rpx; height: 22rpx; }
.tag-loc { background: linear-gradient(135deg, rgba(242,176,61,.92), rgba(240,150,40,.92)); }
.tag-emo { background: linear-gradient(135deg, rgba(91,120,255,.9), rgba(22,183,166,.9)); }
.tag-tm { background: rgba(20,22,31,.6); }

.bubble {
  background: var(--glass); backdrop-filter: blur(28rpx);
  border: 1rpx solid rgba(255,255,255,.55); border-radius: var(--r-md);
  padding: 26rpx 28rpx; box-shadow: var(--sh-2);
  font-size: 31rpx; line-height: 1.62; color: var(--ink);
  max-height: 38vh; overflow-y: auto; word-break: break-word;
}
.bubble-empty { color: var(--ink-2); font-size: 29rpx; }

/* 骨架屏 */
.skeleton { display: flex; flex-direction: column; gap: 16rpx; padding: 4rpx 0; }
.sk-line {
  height: 26rpx; border-radius: 8rpx; width: 100%;
  background: linear-gradient(90deg, rgba(20,22,31,.06) 25%, rgba(20,22,31,.12) 37%, rgba(20,22,31,.06) 63%);
  background-size: 400% 100%; animation: shimmer 1.4s ease infinite;
}
.sk-line.short { width: 52%; }
.skeleton-dark .sk-line { background: linear-gradient(90deg, rgba(20,22,31,.05) 25%, rgba(20,22,31,.1) 37%, rgba(20,22,31,.05) 63%); background-size: 400% 100%; }
@keyframes shimmer { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }

/* ── 底部输入坞 ── */
.dock {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 6; padding: 16rpx 24rpx 0;
  background: linear-gradient(180deg, rgba(245,246,250,0), rgba(245,246,250,.9) 40%);
}
.sugg { white-space: nowrap; padding: 4rpx 2rpx 16rpx; }
.sugg-item {
  display: inline-block; margin-right: 14rpx; padding: 13rpx 24rpx; border-radius: var(--r-pill);
  background: rgba(255,255,255,.9); border: 1rpx solid var(--hairline);
  color: var(--ink); font-size: 25rpx; font-weight: 600; box-shadow: var(--sh-1);
}
.sugg-item:active { background: var(--brand); color: #fff; }

.bar {
  display: flex; align-items: center; gap: 14rpx;
  background: #fff; border-radius: var(--r-pill); padding: 12rpx 12rpx 12rpx 30rpx;
  box-shadow: var(--sh-2); border: 1rpx solid var(--hairline);
}
.bar-input { flex: 1; min-width: 0; font-size: 31rpx; color: var(--ink); }
.bar-ph { color: var(--ink-3); }
.ic {
  width: 80rpx; height: 80rpx; flex: 0 0 auto; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; background: var(--bg);
}
.ic-img { width: 40rpx; height: 40rpx; }
.ic-mic.recording { background: var(--danger); box-shadow: 0 0 0 0 rgba(240,86,62,.5); animation: pulse 1.1s infinite; }
.ic-mic.recognizing { background: var(--gold); }
.ic-go { background: var(--brand-grad); box-shadow: var(--sh-brand); }
.ic-disabled { opacity: .42; }
@keyframes pulse { 0%,100% { box-shadow: 0 0 0 0 rgba(240,86,62,.5); } 50% { box-shadow: 0 0 0 18rpx rgba(240,86,62,0); } }

.mic-hint {
  text-align: center; color: var(--ink-2); font-size: 23rpx; padding: 14rpx 0 4rpx; letter-spacing: 1rpx;
}

/* ── 开场封面 ── */
.cover {
  position: absolute; inset: 0; z-index: 20; padding: 60rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 36rpx; text-align: center;
  background: radial-gradient(120% 78% at 50% 22%, #1c2444 0%, #0c0e14 70%);
  transition: opacity .5s var(--ease), visibility .5s var(--ease);
}
.cover-hide { opacity: 0; visibility: hidden; pointer-events: none; }
.cover-orb {
  width: 200rpx; height: 200rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, rgba(91,120,255,.38), rgba(22,183,166,.32));
  border: 2rpx solid rgba(255,255,255,.22); box-shadow: 0 0 90rpx rgba(91,120,255,.45);
  animation: float 3.4s ease-in-out infinite;
}
.cover-spark { width: 92rpx; height: 92rpx; }
@keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-16rpx); } }
.cover-title { color: #fff; font-size: 50rpx; font-weight: 700; letter-spacing: 6rpx; }
.cover-desc { color: var(--on-dark-2); font-size: 27rpx; line-height: 1.9; max-width: 560rpx; letter-spacing: .5rpx; }
.cover-feats { display: flex; gap: 30rpx; margin-top: 4rpx; }
.feat { display: flex; align-items: center; gap: 8rpx; color: rgba(255,255,255,.78); font-size: 23rpx; }
.feat-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--brand-grad); }
.cover-start {
  margin-top: 12rpx; padding: 26rpx 76rpx; border-radius: var(--r-pill);
  color: #fff; font-size: 33rpx; font-weight: 700; letter-spacing: 8rpx;
  background: var(--brand-grad); box-shadow: var(--sh-brand);
}
.cover-loading { margin-top: 12rpx; display: flex; align-items: center; gap: 14rpx; color: var(--on-dark-2); font-size: 27rpx; }
.spinner {
  width: 34rpx; height: 34rpx; border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,.25); border-top-color: #fff; animation: spin .8s linear infinite;
}

/* ── 行程游记弹层 ── */
.sheet-mask {
  position: absolute; inset: 0; z-index: 30; background: rgba(12,14,20,.5); backdrop-filter: blur(6rpx);
  display: flex; align-items: flex-end; opacity: 0; visibility: hidden; transition: opacity .3s var(--ease), visibility .3s var(--ease);
}
.sheet-mask.show { opacity: 1; visibility: visible; }
.sheet {
  width: 100%; background: var(--bg); border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 12rpx 36rpx 28rpx; max-height: 78vh; overflow-y: auto;
  transform: translateY(100%); transition: transform .34s var(--ease); box-shadow: 0 -12rpx 50rpx rgba(0,0,0,.3);
}
.sheet-mask.show .sheet { transform: translateY(0); }
.grip { width: 72rpx; height: 8rpx; border-radius: 8rpx; background: #d6d9e3; margin: 12rpx auto 22rpx; }
.sheet-head { display: flex; align-items: center; justify-content: center; gap: 14rpx; }
.sheet-ic { width: 52rpx; height: 52rpx; padding: 12rpx; box-sizing: border-box; background: var(--brand-grad); border-radius: 14rpx; }
.sheet-title { font-size: 36rpx; font-weight: 700; letter-spacing: 1rpx; color: var(--ink); }
.sheet-sub { display: block; text-align: center; color: var(--ink-2); font-size: 24rpx; margin-top: 8rpx; }
.sheet-body { margin-top: 26rpx; font-size: 30rpx; line-height: 1.86; color: var(--ink); white-space: pre-wrap; }
